{
  "name": "node-sarif-builder",
  "version": "4.1.0",
  "description": "Module to help building SARIF log files",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.js",
  "repository": "https://github.com/nvuillam/node-sarif-builder",
  "license": "MIT",
  "keywords": [
    "sarif",
    "builder",
    "node",
    "simple",
    "linter",
    "output",
    "format"
  ],
  "author": {
    "name": "Nicolas Vuillamy",
    "email": "nicolas.vuillamy@gmail.com",
    "url": "http://nicolas.vuillamy.fr"
  },
  "scripts": {
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "fix:lint": "eslint \"src/**/*.ts\" --fix",
    "test": "yarn test:unit",
    "test:lint": "eslint \"src/**/*.ts\"",
    "test:prettier": "prettier \"src/**/*.ts\" --list-different",
    "test:unit": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage dist/lib/sarif-builder.test.js",
    "pretest": "tsc",
    "diff-integration-tests": "mkdir -p diff && rm -rf diff/test && cp -r test diff/test && rm -rf diff/test/test-*/.git && cd diff && git init --quiet && git add -A && git commit --quiet --no-verify --allow-empty -m 'WIP' && echo '\\n\\nCommitted most recent integration test output in the \"diff\" directory. Review the changes with \"cd diff && git diff HEAD\" or your preferred git diff viewer.'",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "node --disable-warning=ExperimentalWarning --test --watch dist/lib/sarif-builder.test.js",
    "cov:lcov": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info dist/lib/sarif-builder.test.js",
    "cov:check": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 dist/lib/sarif-builder.test.js",
    "prepublish": "tsc"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "dist/index.js",
    "!**/*.test.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@types/sarif": "^2.1.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^9.39.3",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cspell": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.1.0",
    "typescript": "^6.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "prettier": {
    "singleQuote": true
  }
}
